PROJECT_NAME=movies

# PostgreSQL
POSTGRES_DB=movies
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=movies-db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Elasticsearch
ELASTIC_SCHEMA=http
ELASTIC_HOST=elasticsearch
ELASTIC_PORT=9200

# ETL (PostgreSQL -> Elasticsearch)
ETL_INDEX_NAME=movies
ETL_SCHEMA_PATH=/app/es_schema.json
ETL_STATE_FILE_PATH=/app/state.json
ETL_BATCH_SIZE=200

# FastAPI cache & recommendations
FILM_CACHE_EXPIRE_IN_SECONDS=300
RECOMMENDATIONS_CACHE_TTL_SECONDS=300

# Auth / JWT
AUTH_JWT_SECRET=super-secret-key
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_AUDIENCE=movies-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=864000
AUTH_ROLES_CACHE_TTL_SECONDS=300
AUTH_SUPERUSER_LOGIN=service-admin
AUTH_SUPERUSER_PASSWORD=change-me-superuser-password
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=5
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_REQUESTS=200
API_RATE_LIMIT_EXEMPT_PATHS=/api/openapi,/api/openapi.json

# Google OAuth
AUTH_GOOGLE_CLIENT_ID=change-me
AUTH_GOOGLE_CLIENT_SECRET=change-me
AUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/social/google/callback
AUTH_GOOGLE_POST_LOGIN_REDIRECT_URL=http://localhost:8000/api/openapi

# Tracing (Jaeger)
TRACING_ENABLED=true
TRACING_SERVICE_NAME=auth-content-service
JAEGER_HOST=jaeger
JAEGER_PORT=6831

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka-0:9092,kafka-1:9092,kafka-2:9092
KAFKA_BOOTSTRAP_SERVERS_EXTERNAL=127.0.0.1:9094,127.0.0.1:9095,127.0.0.1:9096

# UGC service
UGC_API_PORT=8001
UGC_DATABASE_URL=postgresql+psycopg://postgres:postgres@movies-db:5432/movies
UGC_KAFKA_TOPIC=ugc.events.raw
UGC_KAFKA_GROUP_ID=ugc-events-consumer
UGC_KAFKA_SEND_MAX_RETRIES=5
UGC_KAFKA_SEND_RETRY_BACKOFF_SEC=1
UGC_KAFKA_SEND_TIMEOUT_SEC=2
UGC_KAFKA_CONSUMER_RECONNECT_BACKOFF_SEC=3
UGC_KAFKA_CONSUMER_PROCESSING_BACKOFF_SEC=1
UGC_RUN_MIGRATIONS_ON_STARTUP=true
UGC_REQUIRE_TRUSTED_USER_ID=false
SENTRY_SERVICE_NAME=ugc-api

# UGC ETL (Kafka -> ClickHouse)
UGC_CLICKHOUSE_ETL_GROUP_ID=ugc-clickhouse-etl
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=ugc
CLICKHOUSE_TABLE=page_views
UGC_ETL_POLL_TIMEOUT_MS=5000
UGC_ETL_BATCH_SIZE=500
UGC_ETL_INSERT_MAX_RETRIES=5
UGC_ETL_RETRY_BACKOFF_SEC=1
UGC_ETL_RECONNECT_BACKOFF_SEC=3
UGC_ETL_METRICS_PORT=9108
UGC_ETL_MEMORY_METRICS_INTERVAL_SEC=5

# Notification service
NOTIFY_API_PORT=8010
NOTIFY_DATABASE_URL=postgresql+psycopg://postgres:postgres@movies-db:5432/movies
NOTIFY_RUN_MIGRATIONS_ON_STARTUP=true
NOTIFY_KAFKA_BOOTSTRAP_SERVERS=kafka-0:9092,kafka-1:9092,kafka-2:9092
NOTIFY_KAFKA_TOPIC=notifications.dispatch
NOTIFY_KAFKA_GROUP_ID=notifications-worker
NOTIFY_WORKER_POLL_INTERVAL_SEC=2
NOTIFY_WORKER_BATCH_SIZE=200
NOTIFY_WORKER_MAX_ATTEMPTS=5
NOTIFY_WEBSOCKET_POLL_INTERVAL_SEC=2
NOTIFY_SCHEDULER_POLL_INTERVAL_SEC=15
NOTIFY_SENDER_MODE=log
NOTIFY_DEFAULT_SENDER_EMAIL=noreply@movies.local
NOTIFY_ADMIN_API_TOKEN=manager-secret
NOTIFY_WEBSOCKET_API_TOKEN=ws-secret
NOTIFY_AUTH_USERINFO_URL_TEMPLATE=http://fastapi:8000/api/v1/auth/users/{user_id}
NOTIFY_AUTH_REQUEST_TIMEOUT_SEC=2
NOTIFY_SHORTLINK_BASE_URL=http://shortlink-api:8020

# Django admin
DJANGO_SECRET_KEY=django-admin-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
AUTH_API_BASE_URL=http://fastapi:8000
AUTH_API_LOGIN_URL=http://fastapi:8000/api/v1/auth/login
AUTH_API_ME_URL=http://fastapi:8000/api/v1/auth/me
AUTH_API_TIMEOUT_SECONDS=5

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
